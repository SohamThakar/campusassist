# =================================================================
# CampusAssist Production Environment Configuration
# Copy this file to .env on your VPS and update the values:
#   cp .env.example .env
# =================================================================

# --- Application Environment ---
# Set to 'production' for live VPS deployments, 'development' for local work
ENVIRONMENT=production

# --- PostgreSQL Production Database ---
# Internal Docker credentials (PostgreSQL container is not exposed publicly)
POSTGRES_USER=campus_user
POSTGRES_PASSWORD=replace_with_strong_database_password_here
POSTGRES_DB=campus_ai
# Async SQLAlchemy connection string used by FastAPI and Alembic:
DATABASE_URL=postgresql+asyncpg://campusassist_app:jJ5YzBfz5gss53WHB7ajkGNna9ryd62q@dpg-dasdpnflk1mc73bhso7g-a/campusassist

# (Optional fallback for local offline testing with SQLite):
# DATABASE_URL=sqlite+aiosqlite:///./campus_ai.db

# --- Security & JWT Authentication ---
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_secure_random_64_character_hex_secret_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Google Gemini AI API ---
# Stored strictly server-side in backend. Never exposed to the frontend browser.
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- CORS Allowed Origins ---
# Set to your production domain(s). Comma-separated.
# No wildcards (*) when credentials are used.
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# --- Persistent Uploads Storage ---
UPLOAD_DIR=/app/uploads
MAX_PHOTO_SIZE_BYTES=5242880
MAX_VIDEO_SIZE_BYTES=52428800
