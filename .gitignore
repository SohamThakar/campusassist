# Environment & Secrets (NEVER commit secrets to version control)
.env
.env.local
.env.*.local
*.env

# Python Virtual Environments & Bytecode
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Local SQLite Database (Do not commit to production)
*.db
*.sqlite
*.sqlite3
campus_ai.db

# Persistent Uploaded Files (Keep directory structure with .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# Node.js & Frontend Build Outputs
node_modules/
frontend/node_modules/
frontend/dist/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating System & IDE Artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
